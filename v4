local function moonEventSeconds(e,kind)
    local detail=tostring(e.detail or ""):lower()
    local mins
    if kind=="full" then
        mins=tonumber(detail:match("(%d+)%s*min%s*until%s*end"))
    elseif kind=="near" then
        mins=tonumber(detail:match("(%d+)%s*min%s*until%s*full%s*moon"))
    end
    local age=(os.time()*1000-(tonumber(e.at) or 0))/1000
    if mins and mins>=0 and mins<=20 then return math.max(0,mins*60-age),true end
    return math.max(0,(kind=="full" and 300 or 180)-age),false
end
local function recordMoonWindow(events)
    local windows=sync.moonWindows or {}
    for _,e in ipairs(events or {}) do
        if type(e)=="table" and T.HasBL(e) and e.route=="moon" and validJob(e.jobId)
            and type(e.at)=="number" then
            local kind=e.title=="Full Moon" and "full" or e.title=="Near Full Moon" and "near" or nil
            if kind then
                local remain,exact=moonEventSeconds(e,kind)
                if remain>0 and exact then
                    local prev=windows[e.jobId]
                    if not prev or tonumber(e.at)>(tonumber(prev.reportedAt) or -1) then
                        windows[e.jobId]={kind=kind,endAt=os.time()+remain,reportedAt=e.at,source="rjr-hint",blWorld=true}
                        hopRecord.hints[e.jobId]=windows[e.jobId]
