                end
            end
        end
        if os.clock()-(self.farmLogAt or -1e6)>8 then
            self.farmLogAt=os.clock()
            syncNote("FARM HOLD","target="..tostring(self.farmTarget and self.farmTarget.Name)
                .." hover=24 candidates="..#targets.." localBring="..brought)
        end
    end
    if os.clock()-(self.farmAttackAt or -1e6)>=.12 then
        self.farmAttackAt=os.clock();self:attackAura(targets,"Haunted Castle training")
    end
end
