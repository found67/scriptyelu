function V4Flow:trialM1Tick()
    if not sync.running or not sync.active or T.cancel or T.raceBusy then self:stopFarm();return end
    -- Immediate transition fence: the independent 0.12s mob loop MUST stop
    -- on the first frame inside the FFA arena. Do not wait for 1.5s phase tick.
    if self.trialSeen and self.phase~="TRAINING"
        and (self:ffa() or self.ffaEnteredAt>0) then
        self:releaseTrial()
        if not sync.main then self:helperResetStep() end
        if sync.main and self.roundState=="FFA" and self:ffa() and not self:ffaCleared() then
            local teamModels={}
            for _,entry in ipairs(self:teammatesAlive()) do
                local p=entry.player
                if p and p.Character then teamModels[#teamModels+1]=p.Character end
            end
            if #teamModels>0 then self:attackAura(teamModels,"FFA MAIN team-only") end
        end
        return
    end
    if self.phase=="TRAINING" and self.progressionActive then
        self:farmStep()
        return
    end
    self:stopFarm()
    local race=self:trial()
    if not race then self:releaseTrial();return end
    if race~="Human" and race~="Ghoul" then return end
    if sync.targetJob~=game.JobId or not self.trialSeen then return end
    local models=self:trialMobs()
    if #models==0 then return end
    local r=HRP();if not r then return end
    -- Source pattern: Farm's Attack.Kill positions above mobs + BringEnemy;
    -- only operate on current trial NPCs, not arbitrary world mobs.
    local closest=nil;local best=math.huge
    for _,mob in ipairs(models) do
        local rp=mob:FindFirstChild("HumanoidRootPart")
        if rp then
            local d=(r.Position-rp.Position).Magnitude
            if d<best then best=d;closest=rp end
        end
    end
    if closest and best>45 and best<1400 and not self.moving then
        self:moveTo(closest.Position+Vector3.new(0,25,0),race.." trial top-farm",1.3)
    end
    -- Clients cannot force server ownership. Use the established local
    -- network-owned mob stack technique, but the RegisterHit packet is the
    -- actual attack. Unowned mobs remain where the server places them.
    if os.clock()-(self.lastBringAt or -1e6)>.28 then
        self.lastBringAt=os.clock()
        pcall(function()
            if type(sethiddenproperty)=="function" then
                sethiddenproperty(LP,"SimulationRadius",math.huge)
            end
        end)
        local base=HRP()
        local stack=base and (base.CFrame*CFrame.new(0,-16,-2))
        for _,mob in ipairs(models) do
            local hp=mob:FindFirstChildOfClass("Humanoid")
            local rp=mob:FindFirstChild("HumanoidRootPart")
            if hp and hp.Health>0 and rp and stack then
                self.mobRestore=self.mobRestore or {}
                if not self.mobRestore[mob] then
                    self.mobRestore[mob]={walk=hp.WalkSpeed,jump=hp.JumpPower,collide=rp.CanCollide}
                end
                pcall(function()
                    rp.CanCollide=false
                    hp.WalkSpeed=0;hp.JumpPower=0
                    if (rp.Position-stack.Position).Magnitude<600 then rp.CFrame=stack end
                end)
            end
        end
    end
    self:attackAura(models,race.." trial")
end

