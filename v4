local function activateV3(cmd, state)
    if not sync.running or not verifyCommand(cmd,state) then return end
    sync.v3RetryNeeded=false
    sync.lastCommand={epoch=cmd.epoch,seq=cmd.seq}
    syncNote("V3", "accepted epoch="..cmd.epoch.." seq="..cmd.seq.." scheduledServerMs="..cmd.runAt)
    local delay=math.clamp((cmd.runAt-(state.serverTime or cmd.runAt))/1000,0,6)
    task.delay(delay,function()
        if not sync.active or T.cancel or not sync.running then return end
        local latest=sync.state
        if not latest or latest.epoch~=cmd.epoch or not latest.target
            or latest.target.jobId~=game.JobId then return end
        local remotes=RS:FindFirstChild("Remotes")
        local comm=remotes and remotes:FindFirstChild("CommE")
        if not comm then syncNote("V3", "FAIL CommE missing"); return end
        sync.v3IssuedAt=os.clock();sync.v3IssuedJob=game.JobId
        -- Every participant uses the SAME planned start, then synchronized
        -- 1.4s repeats. Keep contact controller active through these attempts.
        for attempt=1,4 do
            if T.cancel or not sync.running or sync.targetJob~=game.JobId or localMoon()~="full" then break end
            if sync.v4flow and (sync.v4flow.trialSeen or sync.v4flow:trial()) then
                syncNote("V3", "trial detected; stop repeated V3")
                break
            end
            local onDoor,dist=nearRaceDoor()
            if onDoor then
                local ok,err=pcall(T.DoorV3)
                syncNote("V3", "attempt="..attempt.." seq="..cmd.seq.." fired="..tostring(ok).." dist="..math.floor(dist).." err="..tostring(err))
            else
                syncNote("V3", "attempt="..attempt.." awaiting real door contact, dist="..math.floor(dist==math.huge and -1 or dist))
            end
            task.wait(1.4)
        end
        sync.armed=false
        log("V3 同步触发已尝试；等待真实 Trial 转场确认")
        -- Never pretend a remote call opened the door. If the scheduled
        -- sequence fails to enter a trial, rearm for ONE further backend round.
        task.delay(13,function()
            if T.cancel or not sync.active or not sync.running or sync.epoch~=cmd.epoch then return end
            if sync.targetJob~=game.JobId or localMoon()~="full" then return end
            if sync.v4flow and (sync.v4flow.trialSeen or sync.v4flow:trial()) then return end
            if (cmd.attempt or 1)>=2 then
                syncNote("V3", "two backend rounds exhausted; synchronized local contact retry will take over")
                sync.v3RetryNeeded=true
