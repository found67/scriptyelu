    end
    if race=="Mink" or race=="Rabbit" then
        local finish=model and (model:FindFirstChild("FinishPart",true) or model:FindFirstChild("Exit",true))
        if finish then
            local p=self:partPosition(finish)
            if p then self:moveTo(p,"Speed finish",5) end
        else
            local ceiling=model and model:FindFirstChild("Ceiling",true)
            if ceiling then
                local p=self:partPosition(ceiling)
                if p then self:moveTo(p-Vector3.new(0,20,0),"Speed ceiling fallback",8)end
            end
        end
