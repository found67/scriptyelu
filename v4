local function pollState()
    sync.lastPoll=os.clock()
    local data,err=requestJson("GET","/v1/state?room="..HttpService:UrlEncode(sync.room),nil,false)
    if not data then
        sync.pollOK=false;sync.networkOK=false;sync.lastError=err
        if err~=sync.lastPollError then syncNote("POLL",err);sync.lastPollError=err end
        return
    end
    sync.lastPollError=nil;sync.pollOK=true
    -- A successful GET state must never hide a failed POST heartbeat.
    sync.networkOK=sync.heartbeatOK == true
    if sync.networkOK then sync.lastError=nil
    else sync.lastError=sync.lastHeartbeatError or "waiting for own heartbeat" end
    local priorEpoch=sync.epoch
    if priorEpoch~=nil and data.epoch~=priorEpoch then
        sync.armed=false
        sync.lastCommand=nil
        syncNote("EPOCH", "epoch changed "..tostring(priorEpoch).." -> "..tostring(data.epoch).."; disarmed")
    end
    sync.state=data;sync.epoch=data.epoch
    -- Recover stale/missing registrations automatically, even when the user
    -- never toggles Start. 3/3 counts stored room members, NOT online ones.
    local ownMember,mainMember
    for _,m in ipairs(data.members or {}) do
        if tostring(m.userId)==tostring(LP.UserId) then ownMember=m end
        if tostring(m.userId)==tostring(sync.mainUserId) then mainMember=m end
    end
    if not ownMember or not ownMember.online then
        local age=ownMember and math.floor(math.max(0,((tonumber(data.serverTime) or 0)-(tonumber(ownMember.at) or 0))/1000)) or -1
        sync.selfOffline=true
        sync.offlineReason=ownMember and ("本号心跳已过期 "..age.." 秒") or "后端没有本号在线记录"
        if os.clock()-sync.lastPresenceRepair>7 and not sync.heartbeatBusy then
            sync.lastPresenceRepair=os.clock()
            syncNote("PRESENCE REPAIR",sync.offlineReason.." role="..sync.role)
            task.spawn(function()
                if T.cancel or not sync.active or sync.heartbeatBusy then return end
                sync.heartbeatBusy=true
                local ok,why=pcall(guardedHeartbeat)
                if not ok then syncNote("PRESENCE REPAIR ERROR",why) end
                sync.heartbeatBusy=false
            end)
        end
    else
        sync.selfOffline=false
        if mainMember and not mainMember.online then
            local age=math.floor(math.max(0,((tonumber(data.serverTime) or 0)-(tonumber(mainMember.at) or 0))/1000))
            sync.offlineReason="MAIN 心跳过期 "..age.." 秒；等待主号恢复"
        else
            sync.offlineReason=nil
        end
    end
    local newTarget=data.target and data.target.jobId or nil
    if sync.targetJob~=newTarget then
        sync.armed=false;sync.targetJob=newTarget
        sync.hopFailJob=nil;sync.pendingHop=nil
        syncNote("TARGET", "epoch="..tostring(data.epoch).." job="..tostring(newTarget)
            .." leader="..tostring(data.target and data.target.leaderUserId))
    end
    local parts={}
    for _,m in ipairs(data.members or {}) do
        table.insert(parts,tostring(m.userId)..":"..tostring(m.race)..":"..tostring(m.role or "UNSET")..":"..(m.online and "ON" or "OFF")..":"..(m.ready and "READY" or "WAIT"))
    end
    table.sort(parts)
    local digest=tostring(data.epoch).."/"..tostring(newTarget).."/"..table.concat(parts,",")
    if digest~=sync.lastLoggedState then
        syncNote("ROOM", "room="..sync.room.." "..digest)
        sync.lastLoggedState=digest
    end
    if data.command and data.command.type=="ACTIVATE_V3" then
        activateV3(data.command,data)
    end
end
