        if finish then
            local p=self:partPosition(finish)
            if p then self:moveTo(p,"Angel finish",5)end
        end
        return
    end
    if race=="Fishman" or race=="Shark" then
        local sea=workspace:FindFirstChild("SeaBeasts")
        local root=HRP()
        if sea and root then
            local best,bestD=nil,math.huge
            for _,v in ipairs(sea:GetChildren()) do
                local hp=v:FindFirstChild("Health")
                local rp=v:FindFirstChild("HumanoidRootPart")
                if hp and tonumber(hp.Value) and hp.Value>0 and rp then
                    local d=(root.Position-rp.Position).Magnitude
                    if d<1800 and d<bestD then best,bestD=v,d end
                end
            end
            if best then self:combat(best,true,"Shark Trial SeaBeast") end
        end
        return
    end
    -- Human and Ghoul are BOTH pure enemy farm trials. This method runs at
    -- 1.5s progression cadence; dedicated 0.12s M1/bring loop does the damage.
    local mobs=self:trialMobs()
    if #mobs==0 and os.clock()-(self.lastNoMobLog or -1e6)>9 then
        self.lastNoMobLog=os.clock()
