    if not root or not hp or hp.Health<=0 then self:stopFarm();return end
    local farm=Vector3.new(-9495.68066,453.58624,5977.34863)
    if (root.Position-farm).Magnitude>1500 then self:stopFarm();return end
    if self.moving or T.moving then return end
    local folder=workspace:FindFirstChild("Enemies")
    local targets={};local nearest=nil;local distance=math.huge
