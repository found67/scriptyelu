local function debugPrint(...)
    local chunks = {}
    for i=1,select("#", ...) do chunks[i] = tostring(select(i, ...)) end
    local line = "[" .. tostring(os.date("%H:%M:%S")) .. "] " .. table.concat(chunks, " ")
    -- File-first diagnostics. The normal Roblox print() remains fallback if TXT is unavailable.
    -- Do NOT use rconsoleprint/consoleprint: on some executors these open a separate window.
    table.insert(Debug.lines, line)
    if Debug.fileReady then
        local ok = false
        if not Debug.rewriteOnly and type(appendfile)=="function" then
            ok = pcall(appendfile, Debug.file, line .. "\n")
        end
        if not ok then
            Debug.rewriteOnly = true
            ok = pcall(writefile, Debug.file, table.concat(Debug.lines, "\n") .. "\n")
        end
        if not ok then
            Debug.fileReady = false
            warn("[YELU0 V4 TEST] TXT write failed; falling back to print")
        end
    end
    if not Debug.fileReady then print(line) end
end

