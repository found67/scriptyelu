local function scanMoon()
    local events,err=requestFeed()
    if not events then
        sync.moonError=tostring(err);sync.moonHint=nil
        log("MOON SCAN FAIL: "..tostring(err));return
    end
    sync.moonError=nil
    local now=os.time()*1000
    local map={};local rejectedWorld=0
    for _,event in ipairs(events) do
        if type(event)=="table" and event.route=="moon" and not T.HasBL(event) then
            rejectedWorld+=1
            if rejectedWorld<=3 then
                syncNote("RJR WORLD REJECT","world="..tostring(event.world).." job="..tostring(event.jobId))
            end
        end
        if type(event)=="table" and T.HasBL(event) and event.route=="moon" and validJob(event.jobId)
            and type(event.at)=="number" and tostring(event.world):find("Sea 3",1,true) then
            local title=tostring(event.title or "")
            local kind=title=="Full Moon" and "full" or title=="Near Full Moon" and "near" or nil
            local age=(now-event.at)/1000
            local seconds=kind and moonEventSeconds(event,kind) or 0
            local currentPlayers,maxPlayers=tostring(event.players or ""):match("(%d+)%s*/%s*(%d+)")
            local count=tonumber(currentPlayers); local cap=tonumber(maxPlayers)
            if kind and age>=-20 and seconds>(kind=="full" and 80 or 35)
                and count and cap and cap-count>=2 and not jobRejected(event.jobId) then
                local v={jobId=event.jobId,kind=kind,count=count,cap=cap,seconds=seconds,age=age,probeOnly=(cap-count<3),world=event.world,checkedAt=os.time()}
                local old=map[v.jobId]
                if not old or (v.kind=="full" and old.kind~="full") or (v.seconds>old.seconds and v.kind==old.kind) then
                    map[v.jobId]=v
                end
            end
        end
    end
    local list={}
    for _,e in pairs(map) do table.insert(list,e) end
    table.sort(list,function(a,b)
        if a.kind~=b.kind then return a.kind=="full" end
        if a.count~=b.count then return a.count<b.count end
        return a.seconds>b.seconds
    end)
    sync.moonCandidates=list;sync.scanTime=os.time()
    -- Use feed only for discovered candidates and optional timestamp hint.
    -- Local Sky/ClockTime still decides if the destination is currently valid.
