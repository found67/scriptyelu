    local d=data.RaceDetails or {}
    syncNote("GEAR SNAP","role="..sync.role.." HadPoint="..tostring(data.HadPoint)
        .." level="..tostring(data.RaceLevel).." A="..tostring(d.A).." B="..tostring(d.B).." C="..tostring(d.C)
        .." Gears="..(type(d.Gears)=="table" and table.concat(d.Gears,",") or tostring(d.Gears)))
    if self.pendingGear and self.pendingGear.preserve then
        local plan=self.pendingGear
