function V4Flow:useNextSkill()
    -- Fishman/Shark sea beast trial only: melee/sword plus optional fruit skills.
    local order={{"Melee",{"Z","X","C"}},{"Sword",{"Z","X"}},
        {"Blox Fruit",{"Z","X","C","V"}},{"Gun",{"Z","X"}}}
    self.nextSkillIndex=(self.nextSkillIndex or 0)+1
    local flat={}
    for _,item in ipairs(order) do
        for _,key in ipairs(item[2]) do flat[#flat+1]={item[1],key} end
    end
    local n=#flat
    for step=0,n-1 do
        local idx=((self.nextSkillIndex+step-1)%n)+1
        local candidate=flat[idx]
        if self:equipKind(candidate[1]) then
            self.nextSkillIndex=idx
            self:input(Enum.KeyCode[candidate[2]])
            return true
        end
    end
    return false
end
function V4Flow:combat(target,allowMove,source)
    local rp=target and (target:IsA("BasePart") and target or target:FindFirstChild("HumanoidRootPart"))
    if not rp and target and target:IsA("Model") then rp=target.PrimaryPart end
    local root=HRP();if not rp or not root then return end
    local distance=(rp.Position-root.Position).Magnitude
    if allowMove and distance>28 and distance<1600 then
        self:moveTo(rp.Position+Vector3.new(0,18,6),source,1.8)
        return
    end
    if distance>160 then return end
    if source=="Shark Trial SeaBeast" then
        -- Sea beasts have Health objects rather than Humanoids. Their only
        -- supported pathway in the old Farm source is distance/aim + skills.
        if os.clock()-self.skillAt>1.1 then
            self.skillAt=os.clock()
            self:useNextSkill()
        end
        return
    end
    if source=="Haunted Castle Training" then
        if os.clock()-self.attackAt>.16 then
            self.attackAt=os.clock()
            self:attackAura({target:IsA("Model") and target or target.Parent},"Training M1")
        end
        return
    end
    if source=="FFA teammate" and target.Parent and target.Parent:IsA("Model") then
        if not sync.main or not self:ffa() or self:ffaCleared() then return end
        if os.clock()-self.attackAt>=.14 then
            self.attackAt=os.clock()
            self:attackAura({target.Parent},"FFA team-only")
        end
        -- Re-target each tick and rotate actual Sword/Melee skills; do not
        -- fire Z once, then assume the whole FFA has finished.
        if os.clock()-self.skillAt>1.1 then
            self.skillAt=os.clock()
            if self:selectM1Tool() then
                local seq=sync.attackWeapon=="Melee" and {"Z","X","C"} or {"Z","X"}
                self.ffaSkillIndex=((self.ffaSkillIndex or 0)%#seq)+1
                pcall(function()
                    root.CFrame=CFrame.lookAt(root.Position,Vector3.new(rp.Position.X,root.Position.Y,rp.Position.Z))
                end)
                self:input(Enum.KeyCode[seq[self.ffaSkillIndex]])
            end
        end
    end
    -- Human/Ghoul/training only use dedicated M1 aura, never skill spam.
end
function V4Flow:buffs(phase)
    if not sync.running then return end
    local c=LP.Character
    if not c then return end
    -- Active in trial / MAIN FFA / training. Helpers never reactively attack MAIN.
