                sync.v3RetryNeeded=true
                syncNote("V3 FALLBACK","three server-ready clients; backend has no active V3 command for 16s")
            end
            if ready and nearRaceDoor() and sync.v3RetryNeeded and not stillScheduled then
                local serverTime=workspace:GetServerTimeNow()
                local bucket=math.floor(serverTime/5)
