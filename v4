-- RJR 10/12: it has two reported vacancies, not three. MAIN must enter
-- privately and check >=2 remaining vacancies (or all three already here)
-- before publishing any JobId. The reporter may leave and free a slot.
local function tryRJRProbe(candidate)
    local allowed,reason=T.RJRTargetAllowed(candidate and candidate.jobId,"rjr-probe")
    if not allowed then syncNote("RJR PROBE BLOCKED",reason);return false end
    if not sync.main or not candidate or not validJob(candidate.jobId) then return false end
    if not candidate.probeOnly then return false end
    if not getTeleportQueue() or type(readfile)~="function" then
        sync.moonHint="10/12 候选需 MAIN 探服，但 Potassium 自动注入不可用"
        syncNote("RJR PROBE BLOCKED",sync.moonHint)
        return false
    end
    if T.running then return false end
    if sync.lastRjrProbeJob==candidate.jobId and sync.lastRjrProbeAt
        and os.clock()-sync.lastRjrProbeAt<90 then return false end
    sync.lastRjrProbeJob=candidate.jobId;sync.lastRjrProbeAt=os.clock()
    local from=game.JobId
    hopRecord.scout={from=from,untilAt=os.time()+900,rjrProbe=candidate.jobId}
    saveHopRecord()
    sync.moonHint="RJR 10/12 · MAIN 独自先验证剩余空位"
    syncNote("RJR PROBE",candidate.kind.." "..candidate.count.."/"..candidate.cap.." job="..candidate.jobId)
    local ok,err=requestHop(candidate.jobId)
    if ok then sync.scoutDiscovery=true;return true end
    hopRecord.scout=nil;sync.scoutDiscovery=false;saveHopRecord()
    syncNote("RJR PROBE ERROR",tostring(err))
    return false
end
-- Share the actual server BEFORE gating on teamReady. A teleport can temporarily
-- mark MAIN 0/1 while the other two records remain in the room. Waiting for the
-- same gate before attempting recovery creates a deadlock.
local function teammatesActuallyHere()
    if not sync.state or type(sync.state.members)~="table" or #sync.state.members~=3 then return false end
    local distinct={}
    for _,m in ipairs(sync.state.members) do
        if not m.running or m.role=="UNSET" or distinct[m.race] then return false end
        distinct[m.race]=true
        if not Players:GetPlayerByUserId(tonumber(m.userId) or -1) then return false end
    end
    return true
end
