local function tweenTo(target, stopDistance)
    local root = HRP()
    if not root or T.cancel or T.raceSwitch then return false, "角色不存在/已取消/手动换种族" end
    local goal = typeof(target)=="CFrame" and target or CFrame.new(target)
    local dist = (root.Position-goal.Position).Magnitude
    if dist <= (stopDistance or 6) then return true end
    cleanMovement()
    T.cancel = false
    T.moving = true
    T.part=Instance.new("Part")
    T.part.Name="OptimizedTweenPart_V4_Test"
    T.part.Size=Vector3.new(1,1,1)
    T.part.Anchored=true
    T.part.CanCollide=false
    T.part.CanTouch=false
    T.part.CanQuery=false
    T.part.Transparency=1
    T.part.CFrame=root.CFrame
    T.part.Parent=workspace
    local char=LP.Character
    T.restore={}
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then T.restore[p]=p.CanCollide end
    end
    local speed=190
    T.tween=TS:Create(T.part, TweenInfo.new(math.max(dist/speed,0.05),Enum.EasingStyle.Linear), {CFrame=goal})
    local thisTween=T.tween
    T.connection=Run.Stepped:Connect(function()
        local r=HRP()
        if T.cancel or T.raceSwitch or not r or LP.Character~=char then
            pcall(function() thisTween:Cancel() end)
            return
        end
        r.CFrame=T.part.CFrame
        r.AssemblyLinearVelocity=Vector3.zero
        for p,_ in pairs(T.restore or {}) do
            if p.Parent then p.CanCollide=false end
        end
    end)
    thisTween:Play()
    local state=thisTween.Completed:Wait()
    local canceled=T.cancel or state~=Enum.PlaybackState.Completed
    cleanMovement()
    if canceled then return false,"Tween cancelled" end
    local r=HRP()
    if not r or (r.Position-goal.Position).Magnitude > 15 then
        return false,"位置校验未通过"
    end
    return true
end

local function forceNPC()
    -- Vxeze only trusts NPCLoaded+NPCReady. An inactive replicated NPC model is
    -- not a valid target, even if its name happens to match Mysterious Force.
    local candidates={}
    for _,folder in ipairs({workspace:FindFirstChild("NPCs"),RS:FindFirstChild("NPCs")}) do
        if folder then
            for _,npc in ipairs(folder:GetChildren()) do
                if npc.Name=="Mysterious Force" and npc:IsA("Model")
                    and npc:GetAttribute("NPCLoaded") and npc:GetAttribute("NPCReady")
                    and npc:FindFirstChild("HumanoidRootPart") then
                    table.insert(candidates,npc)
                end
            end
        end
    end
    -- Same NPCManager fallback as Vxeze; only use this to choose a Tween target.
    if #candidates==0 then
        pcall(function()
            local mgr=require(RS:WaitForChild("NPCManager",2))
            for _,obj in ipairs(mgr.getNPCsByName("Mysterious Force") or {}) do
                local n=obj._modelState and obj._modelState._instance
                if n and n:IsA("Model") and n:FindFirstChild("HumanoidRootPart") then
                    table.insert(candidates,n)
                end
            end
        end)
    end
    local best,bestD=nil,math.huge
    for _,npc in ipairs(candidates) do
        local ok,cf=pcall(function()return npc:GetPivot()end)
        if ok then
            local d=(cf.Position-treeWaypoint).Magnitude
            if d<bestD and d<5500 then best,bestD=npc,d end
        end
    end
    return best
end

local function inTemple()
    -- Spatial vicinity ONLY. This is NOT proof that the real temple is loaded.
