        local brought=0
        for _,mob in ipairs(targets) do
            local rp=mob:FindFirstChild("HumanoidRootPart")
            local h=mob:FindFirstChildOfClass("Humanoid")
            if rp and h and (rp.Position-self.farmAnchor.Position).Magnitude<300 then
                local owner=true
                if type(isnetworkowner)=="function" then
                    local ok,value=pcall(isnetworkowner,rp);owner=ok and value==true
                end
