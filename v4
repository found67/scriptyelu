end

local function streamTemple()
    -- Roblox streaming hint; does not fabricate geometry or create a fake map.
    -- Run only when already spatially close to the temple.
    if not inTemple() then return false,"not near" end
    if not workspace.StreamingEnabled then
        debugPrint("[YELU0 V4 STREAM] skipped: StreamingEnabled=false; RequestStreamAroundAsync cannot load Temple from MapStash")
        return false,"streaming disabled"
    end
    local ok,result=pcall(function()return LP:RequestStreamAroundAsync(center)end)
    debugPrint("[YELU0 V4 STREAM] ok="..tostring(ok).." result="..tostring(result))
    return ok,result
end

local function waitForTempleMap(seconds)
    local deadline=os.clock()+seconds
    local count=0
    while os.clock()<deadline and not T.cancel do
        local st=templeMapState()
        if st.ready then
            reportTemple("client layout present")
            return true
        end
        if count==0 or count%8==0 then reportTemple("waiting "..count) end
        count+=1
        task.wait(0.3)
    end
    reportTemple("after wait")
    return templeMapState().ready
end

local function stageTree()
    if T.TeamComplete and T.TeamComplete() then return end
    local flow=T.sync and T.sync.v4flow
    if flow and not flow.clockReturning and flow:resumeProgress() then return end
    if not validWorld[game.PlaceId] then log("请先进入第三海，防止跨海 Tween 到错误坐标"); return end
    if inTemple() then
        reportTemple("A near temple")
        log("坐标已在神殿附近；先用 SNAP 检查是否真地图，勿当成成功")
        return
    end
    local npc=forceNPC()
    if not npc then
        log("未发现已加载的入口 NPC，先 Tween 到 Great Tree 顶部参考点")
        local ok,err=tweenTo(treeWaypoint)
        if not ok then log("A FAIL - 前往大树失败: "..tostring(err)); return end
        task.wait(1)
        npc=forceNPC()
    end
    if not npc then
        log("A WAYPOINT - 已到 Great Tree 参考点；NPC 未加载也可以尝试 B（真实 Check→Teleport）")
        return
    end
    local nroot=npc:FindFirstChild("HumanoidRootPart")
    local pos=nroot and nroot.Position or npc:GetPivot().Position
    log("检测到已加载的 Mysterious Force，Tween 到入口位置")
    for attempt=1,3 do
        if T.cancel then return end
        local updated=forceNPC()
        local liveRoot=updated and updated:FindFirstChild("HumanoidRootPart")
        if liveRoot then pos=liveRoot.Position end
        local r=HRP()
        if r and (r.Position-pos).Magnitude<=10 then break end
        local ok,err=tweenTo(CFrame.new(pos)*CFrame.new(0,0,math.max(1,5-attempt)))
        if not ok then log("A RETRY "..attempt.." - "..tostring(err)) end
        task.wait(.25)
    end
    local r=HRP()
    local d=r and (r.Position-pos).Magnitude or math.huge
    log((d<=12 and "A PASS" or "A CHECK").." - 与入口 NPC 距离 "..math.floor(d).." studs")
end

function T.EnterOnce()
    if not validWorld[game.PlaceId] then log("请先进入第三海，防止跨海 Tween 到错误坐标"); return end
    if inTemple() then
        local st=reportTemple("B initially near")
        if st.ready then log("B CLIENT READY - 已找到神殿与本种族 Trial 门模型"); return end
        log("B PARTIAL - 坐标到达但地图缺失；尝试补回 Vxeze MapStash 加载步骤")
        local loaded,why=borrowTempleForTeleport()
        debugPrint("[YELU0 V4 BORROW] near-existing result="..tostring(loaded).." reason="..tostring(why))
        streamTemple()
        if waitForTempleMap(5) then
            log("B CLIENT LAYOUT READY - 神殿走廊已加载；来源见 TXT，尚需实际验证 Trial")
        else
            log("B PARTIAL - 仍无完整地图；可返回大树后重新执行 A→B，并保留 TXT")
        end
        return
    end
    local r=HRP()
    if not r then log("B FAIL - HumanoidRootPart 不存在"); return end
    local distToTree=(r.Position-treeWaypoint).Magnitude
    if distToTree>3500 then
        log("B WAIT - 不在 Great Tree 附近（"..math.floor(distToTree).." studs），请先运行 A")
        return
    end
    local remotes=RS:FindFirstChild("Remotes")
    local comm=remotes and remotes:FindFirstChild("CommF_")
    if not comm then log("B FAIL - 找不到 ReplicatedStorage.Remotes.CommF_"); return end

    -- User-confirmed live NPC interaction sequence is ONLY:
    --   CommF_:InvokeServer("RaceV4Progress", "Check")
    --   CommF_:InvokeServer("RaceV4Progress", "Teleport")
    -- Do not invent an extra Begin/CheckTempleDoor gate here.
    local before=r.Position
    local okCheck,progress=pcall(function()
        return comm:InvokeServer("RaceV4Progress","Check")
    end)
    debugPrint("[YELU0 V4 ENTER] Check ok="..tostring(okCheck).." value="..tostring(progress))
    if not okCheck then log("B FAIL - Check Remote 出错，workspace TXT/Console 查看错误"); return end
    log("B - Check 返回 "..tostring(progress).."；准备客户端神殿地图再发送 Teleport...")
    -- Required by Vxeze original: make the model available BEFORE sending Teleport.
    local borrowed,borrowStatus=borrowTempleForTeleport()
    debugPrint("[YELU0 V4 BORROW] before Teleport ok="..tostring(borrowed).." mode="..tostring(borrowStatus))
    if not borrowed then
        log("B WAIT - 未能从 MapStash 加载神殿，为避免跌出地图，不发送 Teleport；查看 TXT")
        return
    end
    local okTele,result=pcall(function()
        return comm:InvokeServer("RaceV4Progress","Teleport")
    end)
    debugPrint("[YELU0 V4 ENTER] Teleport ok="..tostring(okTele).." value="..tostring(result).." before="..tostring(before))
    if okTele and typeof(result)=="table" then
        for key,val in pairs(result) do
            if type(key)=="string" or type(key)=="number" then
                debugPrint("[YELU0 V4 ENTER RETURN] "..tostring(key).."="..tostring(val))
            end
        end
    end
    if not okTele then log("B FAIL - Teleport Remote 出错，workspace TXT/Console 查看错误"); return end

    local moved=false
    for _=1,36 do
        if T.cancel then return end
        if inTemple() then moved=true; break end
        task.wait(0.25)
    end
    reportTemple("after Teleport")
    if not moved then
        log("B FAIL - Teleport 后 9 秒仍未到神殿坐标；检查 TXT 返回值")
        return
    end
    -- The old implementation falsely treated the destination coordinates as the real temple.
    log("B POSITION - 到达神殿坐标，等待真正地图/种族门加载...")
    streamTemple()
    if waitForTempleMap(10) then
        log("B CLIENT LAYOUT READY - 已找到神殿与本种族 Trial 门模型，可测试 C（不等于服务器 Trial 已验证）")
    else
        log("B PARTIAL - 坐标抵达但没有完整地图；请按 SNAP，对比手动进入后的数据")
    end
end

-- Keep the actual NPC contact during Check -> Teleport. In the v198 log,
-- physics left the avatar 12 studs away and every Teleport returned nil.
function T.HoldTreeContact(npc)
    if T.entryRelease then T.entryRelease() end
    local char=LP.Character
    local root=HRP()
    local nroot=npc and npc:FindFirstChild("HumanoidRootPart")
    if not root or not nroot or (root.Position-nroot.Position).Magnitude>60 then return nil end
    local old={};local conn=nil;local released=false;local began=os.clock()
    for _,p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then old[p]=p.CanCollide end
    end
    local function release()
        if released then return end
        released=true
        if conn then conn:Disconnect() end
        for p,v in pairs(old) do if p.Parent then pcall(function()p.CanCollide=v end) end end
