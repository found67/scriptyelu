function V4Flow:attackAura(models,tag)
    if T.cancel or not sync.running or type(models)~="table" or #models==0 then return end
    if not self:selectM1Tool() then return end
    local root=HRP();if not root then return end
    local modules=RS:FindFirstChild("Modules")
    local net=modules and modules:FindFirstChild("Net")
    local ra=net and net:FindFirstChild("RE/RegisterAttack")
    local rh=net and net:FindFirstChild("RE/RegisterHit")
    if not (ra and rh) then
        if os.clock()-(self.noNetAt or -1e6)>10 then
            self.noNetAt=os.clock();syncNote("M1 NET", "RegisterAttack/RegisterHit missing")
        end
        local c=LP.Character;local tool=c and c:FindFirstChildOfClass("Tool")
        if tool then pcall(function()tool:Activate()end)end
        return
    end
    local hitList,head=nil,nil
    hitList={}
    for _,model in ipairs(models) do
        if model and model.Parent then
            local player=Players:GetPlayerFromCharacter(model)
            local allowed=false
            if player then
                if sync.main and self.roundState=="FFA" and self:ffa() and not self:ffaCleared() then
                    for _,id in ipairs(self:ffaTeam() or {}) do
                        if tostring(player.UserId)==id and not (self.ffaEliminated or {})[id] then allowed=true end
                    end
                end
            else
                allowed=(self.phase=="TRIAL" and self:trial()~=nil)
                    or (self.phase=="TRAINING" and self.progressionActive==true)
            end
            local rp=model:FindFirstChild("HumanoidRootPart")
            local hum=model:FindFirstChildOfClass("Humanoid")
            if allowed and hum and hum.Health>0 and rp and (rp.Position-root.Position).Magnitude<500
                and (not player or self:insideArena(rp)) then
                head=head or model:FindFirstChild("Head") or rp
                hitList[#hitList+1]={model,rp}
            end
        end
    end
    if #hitList==0 or not head then return end
    local sent,sendErr=pcall(function()
        ra:FireServer(0)
        rh:FireServer(head,hitList)
    end)
    if os.clock()-(self.lastM1SummaryAt or -1e6)>9 then
        self.lastM1SummaryAt=os.clock()
        syncNote("M1 HIT",tostring(tag).." targets="..#hitList.." request="..tostring(sent)
            ..(sent and "" or (" error="..tostring(sendErr))))
    end
    -- Mirror Main v27's optional encrypted route if the live game provides it.
    -- Inspect once per execution, and retry lookup periodically if assets stream.
    if not self.fastNet or os.clock()-(self.fastNet.scanAt or 0)>25 then
        local state={scanAt=os.clock(),id=nil,remote=nil,seed=net:FindFirstChild("seed")}
        for _,folderName in ipairs({"Util","Common","Remotes","Assets","FX"}) do
            local folder=RS:FindFirstChild(folderName)
            if folder then for _,obj in ipairs(folder:GetChildren()) do
                if obj:IsA("RemoteEvent") and obj:GetAttribute("Id") then
                    state.id=obj:GetAttribute("Id");state.remote=obj
                end
            end end
        end
        self.fastNet=state
    end
    local enc=self.fastNet
    if enc and enc.remote and type(enc.id)=="number" and not self.fastEncryptedBusy then
        self.fastEncryptedBusy=true
        task.spawn(function()
        pcall(function()
            local seed=enc.seed and enc.seed:InvokeServer() or 1
            -- seed lookup can yield across a phase change or helper death.
            if T.cancel or not sync.running then return end
            for _,hit in ipairs(hitList) do
                local hp=hit[1]:FindFirstChildOfClass("Humanoid")
                local player=Players:GetPlayerFromCharacter(hit[1])
                if not hp or hp.Health<=0 then return end
                if player then
                    if self.roundState~="FFA" or not self:ffa() or self:ffaCleared() then return end
                elseif not ((self.phase=="TRIAL" and self:trial())
                    or (self.phase=="TRAINING" and self.progressionActive)) then return end
            end
            local eid=bit32.bxor(enc.id+909090,seed*2)
            local timestamp=math.floor(workspace:GetServerTimeNow()/10%10)+1
            local name=string.gsub("RE/RegisterHit",".",function(c)
                return string.char(bit32.bxor(string.byte(c),timestamp))
            end)
            local remote=enc.remote
            if type(cloneref)=="function" then remote=cloneref(remote) end
            remote:FireServer(name,eid,head,hitList)
        end)
        self.fastEncryptedBusy=false
        end)
    end
end
