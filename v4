function V4Flow:train()
    if not self.progressionActive or not sync.running or self:timerActive() then return end
    if os.clock()-self.trainTick<3 then return end
    self.trainTick=os.clock()
    local code,count,price=self:upgrade()
    if not code then self:note("TRAIN_CHECK","升级返回无效，停止攻击与买入");return end
    if code==0 or code==5 then
        if self.roundState=="POST" and not self.clockDone then self:gear();return end
        self:nextRound(code);return
    end
    if code==2 or code==4 or code==7 then
        self:note("TRAIN_BUY","可购买升级；价格="..tostring(price).." 碎片")
        local data=LP:FindFirstChild("Data")
        local fragments=data and data:FindFirstChild("Fragments")
        if type(price)~="number" or price<0 or not fragments or fragments.Value<price then
            self:note("TRAIN_FUNDS","价格或碎片余额不足，等待状态更新");return
        end
        if os.clock()-self.trainBuyTick<30 then return end
        self.trainBuyTick=os.clock()
        local yes,result=v4Comm("UpgradeRace","Buy")
        local after,afterCount=self:upgrade()
        syncNote("TRAIN PURCHASE","before="..code..","..tostring(count).." price="..price
            .." ok="..tostring(yes).." result="..tostring(result)
            .." after="..tostring(after)..","..tostring(afterCount))
        if yes and after~=nil and (after~=code or afterCount~=count) then
            self.purchaseConfirmed=(self.purchaseConfirmed or 0)+1
        end
        if after==code and afterCount==count then
            self:note("TRAIN_BUY_VERIFY","购买后进度未变；等待 30 秒后重新核查")
        end
        return
    end
    if code~=1 and code~=3 and code~=6 and code~=8 then
        self:note("TRAIN_CHECK","未知升级状态="..tostring(code));return
    end
    if self.moving or T.moving then return end
    self:note("TRAINING","本账号训练阶段="..code.." progress="..tostring(count))
    self:buffs("TRAINING")
    local root=HRP();if not root then return end
    local farm=Vector3.new(-9495.68066,453.58624,5977.34863)
    if (root.Position-farm).Magnitude>1500 then self:moveTo(farm,"Haunted Castle Training",8);return end
    self:farmStep()
end
-- Purchase/training is local-account progression, not a team target command.
-- Probe it before navigation, including when only MAIN has been injected.
function V4Flow:resumeProgress()
    if not sync.active or not sync.running or sync.room=="" or sync.role=="UNSET" then return false end
    if T.TeamComplete() then T.HaltForMain();return true end
    if self.clockPending then return true end
    if self.progressionActive or self.roundState=="DONE" then return true end
    if self.roundState~="IDLE" or self:timerActive() then return false end
    if ownRace()=="Unknown" or ownRace()=="Draco" then return true end
    if self.resumeBusy then return true end
    local cooldown=self.progressChecked and 10 or 3
    if os.clock()-(self.lastProgressProbe or -1e6)<cooldown then return not self.progressChecked end
    self.resumeBusy=true
    self.lastProgressProbe=os.clock()
    local code,count,price=self:upgrade()
    self.resumeBusy=false
    syncNote("RESUME STATUS","code="..tostring(code).." count="..tostring(count)
        .." price="..tostring(price).." target="..tostring(sync.targetJob).." current="..game.JobId)
    if code==0 or code==5 then
        -- Max training (5) does not prove that the Clock point has been spent.
        local clockData=self:clock()
        if self:queueClockPoint(clockData) then return true end
        -- Unknown Clock data alone does not create a pending-point obligation.
        -- Only a positive HadPoint snapshot blocks the next V3 round.
        self.progressChecked=true
        if code==5 and sync.main then self:nextRound(code);return true end
        return false
    end
    if code==1 or code==2 or code==3 or code==4 or code==6 or code==7 or code==8 then
        self.progressChecked=true;self.progressionActive=true;self.gearConfirmed=true;sync.armed=false
        if T.entryRelease then T.entryRelease() end
        if T.moving and not self.moving then cleanMovement() end
        self:note("TRAIN_RESUME","读取到本账号训练/购买进度，优先处理；无需等待三人同服")
        return true
    end
    self.progressChecked=false;sync.armed=false
    self:note("TRAIN_CHECK","本账号升级状态尚不可用；等待重查，暂不抢先前往神殿")
    return true
end
function V4Flow:finishFFA()
    if not sync.main or not self.trialSeen or (self.ffaEnteredAt or 0)<=0
        or self.roundState=="POST" or not self:ffaCleared() then return false end
    self.roundState="POST";self.clockDone=false
    self:releaseTrial();cleanMovement();self.moving=false
    self:note("FFA_COMPLETE","两名指定 Helper 均已确认死亡；停止 PvP，进入钟房")
    return true
end
function V4Flow:helperResetStep()
    if sync.main or not sync.running or T.cancel or self.helperResetRequested
        or self.roundState~="FFA" or (self.ffaEnteredAt or 0)<=0 then return false end
    if os.clock()-self.ffaEnteredAt<2 or not self:ffa() then return false end
    local char=LP.Character;local hum=char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health<=0 or char~=self.trialCharacter then return false end
    self.helperResetRequested=true
    self:releaseTrial();cleanMovement();self.moving=false
    self:note("FFA_RESET","已确认进入 FFA 两秒，Helper 重置让 MAIN 完成本轮")
    hum.Health=0
    return true
end
function V4Flow:helperClockCheck()
    if sync.main or self.roundState~="POST" or self.clockPending then return false end
    -- A helper respawn is not a Clock entitlement. Query first, without moving
    -- toward the Clock; helpers who never unlocked switching may return nil.
    if os.clock()-(self.helperClockCheckAt or -1e6)<2 then return true end
    self.helperClockCheckAt=os.clock()
    local data=self:clock()
    if self:queueClockPoint(data) then return true end
    self.helperClockChecks=(self.helperClockChecks or 0)+1
    if type(data)=="table" or self.helperClockChecks>=3 then
        syncNote("HELPER CLOCK DECISION", "Race="..ownRace().." checks="..self.helperClockChecks
            .." response="..(type(data)=="table" and "no pending point in snapshot" or "unknown; no positive point observed")
            .."; return to standby; idle point monitoring remains active")
        self:nextRound(5)
    else
        self:note("HELPER_CLOCK_CHECK","重生后核查待花点数 "..self.helperClockChecks.."/3；暂不移动到 Clock")
    end
    return true
end
function V4Flow:tick()
    if not sync.running or not sync.active or T.cancel then return end
    if ownRace()=="Draco" then self:note("DRACO_SEPARATE","本项目不处理 Draco");return end
    local root=HRP();local character=LP.Character
    local hum=character and character:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health<=0 then self:releaseTrial();return end
    if self.lastRace~="" and self.lastRace~=ownRace() then
        self:note("RACE_CHANGED","本轮中种族改变；请停止后重新注入，避免使用旧齿轮计划");return
    end
    self.lastRace=ownRace()
    if T.TeamComplete() then T.HaltForMain();return end
    if self.roundState=="DONE" then return end
    self:handleTrialExit(character)
    self:finishFFA()
    if self:helperClockCheck() then return end
    local ownsProgress=self:resumeProgress()
    if self.progressionActive then self:train();return end
    if self.clockPending and self.roundState=="POST" then self:gear();return end
    if ownsProgress then return end
    if sync.targetJob~=game.JobId then return end
    if self.roundState=="POST" then self:gear();return end
    local race,model=self:trial()
    if race then
        if not self.trialSeen then
            self.clockVerified=false
            self.trialSeen=true;self.firstSeenAt=os.clock();self.roundState="TRIAL"
            self.trialCharacter=character
            sync.v3IssuedAt=sync.v3IssuedAt or os.clock();sync.v3IssuedJob=game.JobId
            syncNote("TRIAL START",race.." confirmed by timer and trial location")
        end
        self:note("TRIAL",race.." 正在执行");self.trialCombatActive=true
        self:buffs("TRIAL");self:trialCombat(race,model);return
    end
    if not self.trialSeen then return end
    self:releaseTrial()
    if self:ffa() then
        if self.ffaEnteredAt==0 then
            self.ffaEnteredAt=os.clock();self.roundState="FFA"
            self.ffaOrigin=self:arenaField().Position
            self.ffaEliminated={};self.ffaWatched={}
            syncNote("FFA START","real border and timer; NPC aura stopped; team IDs frozen")
        end
        if sync.main then
            local targets=self:teammatesAlive()
            if self:finishFFA() then self:gear();return end
            self:note("FFA_MAIN",#targets>0 and "持续追踪存活 Helper" or "队友暂时不可见；不将目标缺失当作击败")
            if #targets>0 then
                self:buffs("FFA")
                table.sort(targets,function(a,b)return (a.root.Position-root.Position).Magnitude<(b.root.Position-root.Position).Magnitude end)
                self:combat(targets[1].root,true,"FFA teammate")
            end
        else
            self:note("FFA_HELPER","停止一切攻击；进入 FFA 两秒后重置")
            self:helperResetStep()
        end
        return
    end
    -- Respawn / confirmed return is handled above. A hidden timer never
    -- promotes either race-trial transition or an active FFA to Clock.
    self:note("TRIAL_TRANSITION","已停刷怪与技能，等待真实 FFA 区域和计时器；转场不前往钟房")
end
