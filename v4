local function templeMapState()
    local map=workspace:FindFirstChild("Map")
    local temple=map and map:FindFirstChild("Temple of Time")
    local stash=RS:FindFirstChild("MapStash")
    local stashed=stash and stash:FindFirstChild("Temple of Time")
    local d=LP:FindFirstChild("Data")
    local race=d and d:FindFirstChild("Race") and tostring(d.Race.Value) or "Unknown"
    local corridor=temple and (temple:FindFirstChild(race.."Corridor") or
        (aliases[race] and temple:FindFirstChild(aliases[race].."Corridor")))
    local door=nil
    if corridor then
        pcall(function() door=corridor.Door.Door.RightDoor.Union end)
    end
    local borrowed=temple and temple:GetAttribute("ClientBorrowed")==true or false
    local ready=inTemple() and temple~=nil and corridor~=nil and door~=nil and not borrowed
    return { near=inTemple(), map=temple, stash=stashed~=nil, corridor=corridor, door=door,
             borrowed=borrowed, ready=ready, race=race }
end

-- v1.9.6: contact target is the CENTER of the actual paired doors, from the
-- central Temple side. Never report READY merely because the avatar is within
-- a 34-stud radius of the RightDoor Union.
local function raceDoorContact()
    local st=templeMapState()
    if not st.ready or not st.door then return nil,nil,"door not ready" end
    local right=st.door
    local pair=st.corridor and st.corridor:FindFirstChild("Door")
    local frame=pair and pair:FindFirstChild("Door")
    local leftFolder=frame and frame:FindFirstChild("LeftDoor")
    local left=leftFolder and leftFolder:FindFirstChild("Union")
    local midpoint=right.Position
    if left and left:IsA("BasePart") then
        midpoint=(right.Position+left.Position)*0.5
    end
    local inward=Vector3.new(center.X-midpoint.X,0,center.Z-midpoint.Z)
    if inward.Magnitude<0.01 then inward=Vector3.new(0,0,1) end
    inward=inward.Unit
    -- Thickness projected along the actual door normal: no fixed 11-stud gap.
    local cf=right.CFrame
    local half=(math.abs(inward:Dot(cf.RightVector))*right.Size.X
        +math.abs(inward:Dot(cf.UpVector))*right.Size.Y
        +math.abs(inward:Dot(cf.LookVector))*right.Size.Z)*0.5
    local standOff=math.clamp(half+0.7,1.35,4.5)
    local point=Vector3.new(midpoint.X,midpoint.Y,midpoint.Z)+inward*standOff
    return point,midpoint,st.race
end

-- Vxeze source (original ~L7150-7185) locally borrows the ACTUAL Temple model
-- from ReplicatedStorage.MapStash before RaceV4Progress/Teleport. The server
-- moves our player, but without this client-side map transfer there is no floor
-- and the character falls (confirmed by v0.7 log). This is a map-loading step,
-- NOT proof the server admitted the account into a playable trial.
local function borrowTempleForTeleport()
    local map=workspace:FindFirstChild("Map")
    local stash=RS:FindFirstChild("MapStash")
    if not map or not stash then
        debugPrint("[YELU0 V4 BORROW] FAIL Map/MapStash missing map="..tostring(map~=nil).." stash="..tostring(stash~=nil))
        return false,"map/stash missing"
    end
    local current=map:FindFirstChild("Temple of Time")
    if current then
        debugPrint("[YELU0 V4 BORROW] SKIP temple already in Workspace.Map, borrowed="..tostring(current:GetAttribute("ClientBorrowed")))
        return true,"already present"
    end
    local model=stash:FindFirstChild("Temple of Time")
    if not model then
        debugPrint("[YELU0 V4 BORROW] FAIL Temple not in MapStash")
        return false,"Temple not in MapStash"
    end
    local state={model=model, began=os.clock(), completed=false}
    T.templeBorrow=state
    model:SetAttribute("ClientBorrowed",true)
    model.Parent=map
    debugPrint("[YELU0 V4 BORROW] moved actual Temple of Time model MapStash -> workspace.Map; await server teleport")

    task.spawn(function()
        local anchor=Vector3.new(28282.57,14896.851,105.10427) -- Vxeze arrival coordinate
        local deadline=os.clock()+30
        while os.clock()<deadline and not T.cancel do
            if model.Parent~=map then break end
            local root=HRP()
            if root and (root.Position-anchor).Magnitude<1000 then
                model:SetAttribute("ClientBorrowed",nil)
                state.completed=true
                debugPrint("[YELU0 V4 BORROW] ARRIVED; ClientBorrowed cleared, temple layout retained. Origin=MapStash")
                return
            end
            task.wait(0.2)
        end
        -- Never destroy the map under a player who may be standing in the temple.
        local root=HRP()
        if model.Parent==map and root and (root.Position-anchor).Magnitude<1000 then
            model:SetAttribute("ClientBorrowed",nil)
            state.completed=true
            debugPrint("[YELU0 V4 BORROW] keep temple: avatar near arrival on cleanup")
        elseif model.Parent==map then
            model:SetAttribute("ClientBorrowed",nil)
            model.Parent=stash
            debugPrint("[YELU0 V4 BORROW] rollback Temple into MapStash (teleport/arrival failed or stopped)")
        else
            model:SetAttribute("ClientBorrowed",nil)
            debugPrint("[YELU0 V4 BORROW] external temple parent change="..tostring(model.Parent))
        end
        if T.templeBorrow==state then T.templeBorrow=nil end
    end)
    return true,"borrowed"
end

