local function requestJson(method,path,data,admin)
    if not sync.active then return nil,"stopped" end
    if sync.room=="" then return nil,"select MAIN UserId / 先绑定队伍" end
    if not sync.betaMode or #sync.betaToken~=64 then return nil,"private beta capability not configured" end
    if admin and not hasAdmin() then return nil,"select MAIN role first" end
    local fn=serviceRequester()
    if not fn then return nil,"Executor HTTP request not available" end
    local h={ ["X-V4-Beta-Key"]=sync.betaToken, ["Content-Type"]="application/json" }
    -- Requests are routed into independent team rooms by MAIN UserId.
    local apiPath=path:gsub("^/v1/", "/v1/beta/")
    -- Timeout is honored by common Potassium request providers; prevents a
    -- wedged heartbeat from blocking registration indefinitely.
    local request={ Url=sync.api..apiPath, Method=method, Headers=h, Timeout=12 }
    if data then
        local enc,body=pcall(function() return HttpService:JSONEncode(data) end)
        if not enc then return nil,"JSON encode failed" end
        request.Body=body
    end
    local ok,response=pcall(fn,request)
    if not ok then return nil,"HTTP exception: "..tostring(response) end
    if typeof(response)~="table" then return nil,"Invalid HTTP response" end
    local status=tonumber(response.StatusCode or response.Status or 0) or 0
    local body=response.Body or response.body or ""
    local decoded=nil
    if type(body)=="string" and body~="" then
        local decodedOK,v=pcall(function()return HttpService:JSONDecode(body)end)
        if decodedOK and type(v)=="table" then decoded=v end
    end
    if status<200 or status>=300 then
        local reason=decoded and (decoded.error or decoded.message) or "non-JSON server response"
        if decoded and type(decoded.reasons)=="table" then reason=tostring(reason)..": "..table.concat(decoded.reasons,"; ") end
        return nil,"HTTP "..tostring(status).." "..tostring(reason)
    end
    if not decoded or not decoded.ok then return nil,"unexpected response "..tostring(status) end
    return decoded,nil
end
