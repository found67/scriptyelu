-- Prefer the in-game server browser; use Roblox's public-server list only as
-- a fallback when getjob is unavailable or repeatedly returns an unusable JobId.
local function findScoutCandidate()
    local browser=RS:FindFirstChild("__ServerBrowser")
    if browser then
        local ok,value=pcall(function()return browser:InvokeServer("getjob")end)
        if ok and validJob(value) and value~=game.JobId and not jobRejected(value) then
            return value,"ServerBrowser"
        end
        syncNote("SCOUT", "getjob unusable: "..tostring(value))
    else
        syncNote("SCOUT","__ServerBrowser unavailable")
    end
    local fn=serviceRequester()
    if not fn then return nil,"no executor HTTP request function" end
    local place=tostring(game.PlaceId)
    local baseUrl="https://games.roblox.com/v1/games/"..place.."/servers/Public?sortOrder=Asc&limit=100"
    local cursor=nil
    for page=1,2 do
        local url=baseUrl..(cursor and ("&cursor="..HttpService:UrlEncode(cursor)) or "")
        local ok,res=pcall(fn,{Url=url,Method="GET",Headers={["Accept"]="application/json"},Timeout=10})
        if not ok or type(res)~="table" then return nil,"Roblox public list HTTP unavailable: "..tostring(res) end
        local code=tonumber(res.StatusCode or res.Status or 0) or 0
        if code~=200 then return nil,"Roblox public list HTTP "..code end
        local decodedOK,body=pcall(function() return HttpService:JSONDecode(tostring(res.Body or res.body or "")) end)
        if not decodedOK or type(body)~="table" then return nil,"Roblox public list decode failed" end
        local eligible={}
        for _,entry in ipairs(body.data or {}) do
