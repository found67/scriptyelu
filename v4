                    if not self.farmRestore[mob] then
                        self.farmRestore[mob]={walk=h.WalkSpeed,jump=h.JumpPower,collide=rp.CanCollide}
                    end
                    local ok=pcall(function()
                        rp.CanCollide=false;h.WalkSpeed=0;h.JumpPower=0
                        rp.CFrame=self.farmAnchor;rp.AssemblyLinearVelocity=Vector3.zero
                    end)
