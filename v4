function V4Flow:startFarmHold(root)
    if self.farmHold then return end
    local char=LP.Character
    local hold={char=char,root=root,restore={}}
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then hold.restore[part]=part.CanCollide end
    end
    -- Vxeze AddFloatForce pattern; only this module's force is removed on exit.
    hold.force=Instance.new("BodyVelocity")
    hold.force.Name="YELU0_V4_TrainingFloat"
    hold.force.Velocity=Vector3.zero
    hold.force.MaxForce=Vector3.new(100000,100000,100000)
    hold.force.P=10000;hold.force.Parent=root
    self.farmHold=hold
    hold.conn=Run.Stepped:Connect(function()
        local ok,err=pcall(function()
            if T.cancel or T.raceBusy or not sync.running or not self.progressionActive
                or self.phase~="TRAINING" or self:timerActive() or LP.Character~=char
                or not root.Parent or self.moving or T.moving or not self:farmMob(self.farmTarget) then
                self:stopFarm();return
            end
            local hp=char:FindFirstChildOfClass("Humanoid")
            local goal=self.farmAnchor and self.farmAnchor*CFrame.new(0,24,0)
            if not hp or hp.Health<=0 or not goal or (root.Position-goal.Position).Magnitude>140 then
                self:stopFarm();return
            end
            for _,part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if hold.restore[part]==nil then hold.restore[part]=part.CanCollide end
                    part.CanCollide=false
                end
            end
            root.CFrame=goal;root.AssemblyLinearVelocity=Vector3.zero
            hold.force.Velocity=Vector3.zero
        end)
        if not ok then
            self:stopFarm()
            if os.clock()-(self.farmErrorAt or -1e6)>8 then self.farmErrorAt=os.clock();syncNote("FARM HOLD ERROR",err) end
        end
    end)
end
function V4Flow:farmStep()
