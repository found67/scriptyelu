        if sync.v4flow and seenRound~=sync.v4flow.roundSerial then
            seenRound=sync.v4flow.roundSerial;attempts=0;lastBucket=nil;allReadySince=nil
        end
        if attempts<36 and sync.running
            and sync.targetJob==game.JobId and localMoon()=="full"
            and not (sync.v4flow and (sync.v4flow.trialSeen or sync.v4flow:trial())) then
            local state=sync.state
