        local v=list[1]; log("RJR 发现候选: "..v.kind.." "..v.count.."/"..v.cap.." 剩余约 "..math.floor(v.seconds).."s")
    else log("RJR 尚无可用月服；9/12 直接集合，10/12 先 MAIN 探服验证") end
end

local function heartbeat()
    sync.lastHeartbeatAttempt=os.clock()
    local moon=localMoon()
    local atDoor,dist=nearRaceDoor()
    local ready=sync.role~="UNSET" and sync.armed and atDoor and moon=="full" and sync.targetJob==game.JobId
        and not (sync.v4flow and (sync.v4flow.clockPending or sync.v4flow.roundState=="POST"))
    -- Role must be explicitly selected; backend enforces exactly one MAIN.
    local stage="idle"
    if inTemple() then stage="temple" end
    if atDoor then stage="door" end
    if ready then stage="ready" end
    if sync.armed and not ready then stage="armed_wait" end
    if sync.hopFailJob and sync.targetJob==sync.hopFailJob then stage="hopfail" end
    local progressStage=T.ProgressStage()
    if progressStage then stage=progressStage;ready=false
    elseif T.TeamComplete() then stage="wait_main_complete";ready=false
    elseif sync.running and T.MainTraining() then stage="wait_main_training";ready=false end
    local payload={room=sync.room,userId=tostring(LP.UserId),race=ownRace(),jobId=tostring(game.JobId),
        ready=ready,moon=moon,stage=stage,role=sync.role,priority=sync.priority,protectedHelper=sync.protected,running=sync.running,
        freeSlots=math.max(0,Players.MaxPlayers-#Players:GetPlayers())}
    local requestBegan=os.clock()
    local res,err=requestJson("POST","/v1/heartbeat",payload,false)
    sync.heartbeatSeconds=os.clock()-requestBegan
    if sync.lastReadySent~=ready or sync.heartbeatSeconds>=3 then
        syncNote("HEARTBEAT RTT",string.format("%.2fs ready=%s doorGap=%.2f",sync.heartbeatSeconds,tostring(ready),dist))
    end
    sync.lastReadySent=ready
    if not res then
        sync.heartbeatOK=false
        sync.networkOK=false
        if err~=sync.lastHeartbeatError then syncNote("HEARTBEAT FAIL",err) end
        sync.lastHeartbeatError=err
        sync.lastError=err
        return
    end
    sync.heartbeatOK=true;sync.lastHeartbeatError=nil
    sync.networkOK=true;sync.lastError=nil;sync.lastHeartbeat=os.clock()
    sync.selfOffline=false;sync.offlineReason=nil
    -- v0.7 server can recover the real full-moon job from MAIN heartbeat,
    -- even if a separate /target POST was skipped during teleport/reload.
    if type(res.target)=="table" and res.target.jobId and res.target.leaderUserId==sync.mainUserId
        and sync.targetJob~=res.target.jobId then
        syncNote("AUTO ADOPT", "backend target="..tostring(res.target.jobId).." source="..tostring(res.target.source))
        sync.targetJob=res.target.jobId;sync.epoch=res.epoch;sync.armed=false
        sync.lastPoll=-1000000
    end
    if ready~=sync.lastSentReady or stage~=sync.lastSentStage then
        syncNote("HEARTBEAT", "race="..ownRace().." job="..tostring(game.JobId)
            .." ready="..tostring(ready).." stage="..stage.." moon="..moon
            .." doorDist="..math.floor(dist==math.huge and -1 or dist))
        sync.lastSentReady=ready;sync.lastSentStage=stage
    end
end
