function V4Flow:gearPlan(data)
    if type(data)~="table" or not self:clockHasPoint(data) then return nil end
    if type(data.RaceLevel)~="number" then return nil,"missing RaceLevel" end
    if data.RaceLevel<2 then return {first=true} end
    local d=data.RaceDetails
    if type(d)~="table" or type(d.Gears)~="table" or type(d.A)~="number" or type(d.B)~="number" then
        return nil,"missing RaceDetails"
    end
    local sum=d.A+d.B
    if d.A<0 or d.B<0 or d.A>2 or d.B>2 or d.A%1~=0 or d.B%1~=0 or sum>3 then
        return nil,"unexpected branch levels"
    end
    local a,b=0,0
    for _,g in pairs(d.Gears) do
        if g=="A" then a+=1 elseif g=="B" then b+=1 else return nil,"unexpected gear encoding" end
    end
    if a~=d.A or b~=d.B then return nil,"gear counts not synchronized" end
    if sum<3 then
        local branch=self.gearPreferences[data.Race or ownRace()] or "Omega"
        if branch=="Alpha" and d.A>=2 then branch="Omega" end
        if branch=="Omega" and d.B>=2 then branch="Alpha" end
        if (branch=="Alpha" and d.A>=2) or (branch=="Omega" and d.B>=2) then return nil,"no legal branch" end
        return {slot="Gear"..tostring(sum+2),branch=branch,a=d.A,b=d.B,gears=d.Gears}
    end
    -- Never switch a maxed helper to the other branch. Try an existing branch
    -- only on a selectable slot, matching LocalScriptTemple's CanSelect rules.
    for i=1,3 do
        local g=d.Gears[i]
        local selectable=true
        local g1,g2,g3=d.Gears[1],d.Gears[2],d.Gears[3]
        if (g1==g2 and g3~=g1) then selectable=i~=3
        elseif g2==g3 and g1~=g2 then selectable=i==2
        elseif g1==g3 and g2~=g1 then selectable=i==1 end
        if selectable and (g=="A" or g=="B") then
            return {slot="Gear"..(i+1),branch=g=="A" and "Alpha" or "Omega",
                preserve=true,a=d.A,b=d.B,gears=d.Gears}
        end
    end
    return nil,"no verified selectable existing gear"
end
