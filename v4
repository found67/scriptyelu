end
function V4Flow:holdClock(pos,reach)
    if self.clockHold then return true end
    local root=HRP();local char=LP.Character
    if not root or (root.Position-pos).Magnitude>25 then return false end
    -- A final short contact adjustment only after the normal Clock tween.
    local delta=root.Position-pos
    local offset=delta.Magnitude>.01 and delta.Unit*math.min(2,reach*.5) or Vector3.new(0,0,1)
    local goal=CFrame.lookAt(pos+offset,pos)
    local hold={restore={},char=char,root=root,began=os.clock()}
    for _,part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then hold.restore[part]=part.CanCollide end
    end
    if self.moving or T.moving then cleanMovement();self.moving=false end
    hold.force=Instance.new("BodyVelocity");hold.force.Name="YELU0_V4_ClockFloat"
    hold.force.MaxForce=Vector3.new(100000,100000,100000);hold.force.P=10000
    hold.force.Velocity=Vector3.zero;hold.force.Parent=root
    self.clockHold=hold
    local function step()
        local hp=char:FindFirstChildOfClass("Humanoid")
        if T.cancel or not sync.running or self.roundState~="POST" or self.clockDone
            or LP.Character~=char or not root.Parent or not hp or hp.Health<=0
            or os.clock()-hold.began>15 or (root.Position-pos).Magnitude>80 then
            self:stopClockHold();return
        end
        for part in pairs(hold.restore) do if part.Parent then part.CanCollide=false end end
        root.CFrame=goal;root.AssemblyLinearVelocity=Vector3.zero
    end
    step();hold.conn=Run.Stepped:Connect(function()
        local ok,err=pcall(step)
        if not ok then self:stopClockHold();syncNote("CLOCK HOLD ERROR",err) end
    end)
    return self.clockHold~=nil
end
function V4Flow:handleTrialExit(character)
