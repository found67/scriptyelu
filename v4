local function cleanMovement()
    if T.tween then pcall(function() T.tween:Cancel() end) end
    T.tween = nil
    if T.connection then T.connection:Disconnect(); T.connection = nil end
    if T.restore then
        for part, value in pairs(T.restore) do
            if part and part.Parent then pcall(function() part.CanCollide = value end) end
        end
        T.restore = nil
    end
    if T.part then T.part:Destroy(); T.part = nil end
    T.moving = false
end

