local function requestHop(job)
    local followOK,followWhy=T.MainFollowAllowed(job)
    if not followOK then syncNote("HOP BLOCKED",followWhy);return false,followWhy end
    if not validJob(job) or job==game.JobId or jobRejected(job) then return false,"invalid/rejected job" end
    if not queueLocalReload() then return false,"local teleport reload unavailable" end
    sync.pendingHop=job;sync.pendingHopAt=os.clock()
    local browser=RS:FindFirstChild("__ServerBrowser")
    local ok,res=false,nil
    if browser then ok,res=pcall(function()return browser:InvokeServer("teleport",job)end) end
    syncNote("HOP","browser="..tostring(ok).." response="..tostring(res))
    if not ok or res==false or (type(res)=="table" and res.WasSuccess==false) then
        ok,res=pcall(function()TeleportService:TeleportToPlaceInstance(game.PlaceId,job,LP)end)
        syncNote("HOP","fallback="..tostring(ok).." response="..tostring(res))
    end
    if not ok or res==false then
